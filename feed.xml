---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>Research updates | {{ site.name | xml_escape }}</title>
  <subtitle>News, publications and research activities from Meng Yuan.</subtitle>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.name | xml_escape }}</name></author>
  {% for item in site.data.news %}
  {% capture entry_path %}/#news-{{ item.id }}{% endcapture %}
  <entry>
    <title type="text">{{ item.title | xml_escape }}</title>
    <link href="{{ entry_path | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
    <id>{{ entry_path | absolute_url | xml_escape }}</id>
    <published>{{ item.date | date_to_xmlschema }}</published>
    <updated>{{ item.updated | default: item.date | date_to_xmlschema }}</updated>
    <content type="html" xml:base="{{ '/' | absolute_url | xml_escape }}">{{ item.content | markdownify | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
